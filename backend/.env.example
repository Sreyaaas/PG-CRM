# Copy to backend/.env for local development.
PGCRM_ENVIRONMENT=dev
PGCRM_DATABASE_URL=postgresql://pgcrm:pgcrm@localhost:5432/pgcrm
# Generate a long random value for any shared or production environment.
PGCRM_JWT_SECRET=dev-only-change-me-dev-only-change-me
PGCRM_CORS_ORIGINS=["http://localhost:5173", "http://localhost:4173"]
# Private file storage (any S3-compatible service: RustFS locally, Supabase Storage / AWS S3 / R2 in prod).
PGCRM_S3_ENDPOINT=http://localhost:9000
PGCRM_S3_BUCKET=pgcrm-private
PGCRM_S3_ACCESS_KEY=pgcrm
PGCRM_S3_SECRET_KEY=pgcrm-dev-secret
PGCRM_S3_REGION=us-east-1
# Where the PWA is served; receipt links are <this>/receipt/<token>.
PGCRM_PUBLIC_APP_URL=http://localhost:5173
