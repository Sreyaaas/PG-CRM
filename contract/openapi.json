  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "JoinInfo": {
        "properties": {
          "property_name": {
            "type": "string",
            "title": "Property Name"
          },
          "locality": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locality"
          },
          "organization_name": {
            "type": "string",
            "title": "Organization Name"
          },
          "house_rules": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "House Rules"
          },
          "exit_deduction_paise": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Exit Deduction Paise",
            "description": "Amount in paise (\u20b91 = 100)"
          },
          "short_term_daily_rate_paise": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0,
                "description": "Amount in paise (\u20b91 = 100)"
              },
              {
                "type": "null"
              }
            ],
            "title": "Short Term Daily Rate Paise"
          },
          "upi_vpa": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upi Vpa"
          },
          "upi_payee_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upi Payee Name"
          },
          "rent_due_day": {
            "type": "integer",
            "title": "Rent Due Day"
          },
          "security_deposit_paise": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Security Deposit Paise",
            "description": "Amount in paise (\u20b91 = 100)"
          },
          "maintenance_charge_paise": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Maintenance Charge Paise",
            "description": "Amount in paise (\u20b91 = 100)"
          },
          "notice_deadline_day": {
            "type": "integer",
            "title": "Notice Deadline Day"
          }
        },
        "type": "object",
        "required": [
          "property_name",
          "locality",
          "organization_name",
          "house_rules",
          "exit_deduction_paise",
          "short_term_daily_rate_paise",
          "upi_vpa",
          "upi_payee_name",
          "rent_due_day",
          "security_deposit_paise",
          "maintenance_charge_paise",
          "notice_deadline_day"
        ],
        "title": "JoinInfo"
      },
      "LoginRequest": {
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^[6-9][0-9]{9}$",
            "title": "Phone"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 6,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "phone",
          "password"
        ],
        "title": "LoginRequest"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/Membership"
            },
            "type": "array",
            "title": "Memberships"
          }
        },
        "type": "object",
        "required": [
          "id",
          "phone",
          "full_name",
          "memberships"
        ],
        "title": "Me"
      },
      "Membership": {
        "properties": {
          "org_id": {
            "type": "string",
            "format": "uuid",
            "title": "Org Id"
          },
          "organization_name": {
            "type": "string",
            "title": "Organization Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "caretaker"
            ],
            "title": "Role"
          },
          "assigned_property_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Assigned Property Ids"
          }
        },
        "type": "object",
        "required": [
          "org_id",
          "organization_name",
          "role",
          "assigned_property_ids"
        ],
        "title": "Membership"
      },
